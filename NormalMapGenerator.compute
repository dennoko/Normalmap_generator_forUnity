#pragma kernel Binarize
#pragma kernel JFA_Init
#pragma kernel JFA_Step
#pragma kernel JFA_Distance
#pragma kernel BlurProfileH
#pragma kernel BlurProfileV
#pragma kernel CompositeHeightMap
#pragma kernel GenerateNormalMap

// ================================================================
// Shared parameters (set via ComputeShader.SetInt / SetFloat)
// ================================================================
int   _Width;          // working (destination) resolution
int   _Height;
int   _SrcWidth;       // source texture resolution (Binarize only)
int   _SrcHeight;
int   _InputIsLinear;  // 1 = _InputTex reads come back linear -> re-encode to display space
float _Threshold;
float _BevelRadius;    // float: preview downscaling needs sub-pixel radii
float _Strength;       // float: ditto
int   _ProfileType;    // 0=Linear, 1=Logarithmic, 2=Exponential, 3=Smoothstep
int   _NormalMapType;  // 0=DirectX (Y+), 1=OpenGL (Y-)
int   _InputMode;      // 0=Threshold, 1=GrayWeight
int   _InvertMask;     // 0 or 1
int   _DisableBevel;   // 0 or 1
int   _JFAStep;        // current step size used in JFA_Step kernel
float _BlurSigma;      // gaussian sigma for the bevel smoothing pass
int   _BlurRadius;     // gaussian tap radius (pixels, per side)
int   _DitherEnabled;  // 1 = dither before 8-bit quantization

// Sentinel for "this pixel owns no seed yet".
// Must stay far below any valid coordinate: sub-pixel seeds can be slightly
// negative (a boundary pixel at x=0 may resolve to x=-0.4), so a plain
// negative test would misclassify them.
#define NO_SEED       (-1e9)
#define IS_SEED(s)    ((s).x > -1e8)
// Radius-independent "no boundary anywhere near" marker written by
// JFA_Distance. Keeping it independent of _BevelRadius is what allows the
// distance field to be cached across radius changes.
#define DIST_FAR      (1e6)
// Upper bound on box-filter taps per axis when Binarize downsamples.
#define MAX_BOX_TAPS       8
#define MAX_BOX_TAPS_LOG2  3

// ================================================================
// Texture resources
// Each kernel uses only the textures it binds via SetTexture()
// ================================================================

// --- Binarize ---
Texture2D<float4>   _InputTex;     // RGBA input from Project (source resolution)
RWTexture2D<float>  _BinaryOut;    // binary mask (0.0 or 1.0)
RWTexture2D<float>  _GrayOut;      // grayscale (0.0 - 1.0), display space

// --- JFA ---
Texture2D<float>    _BinaryIn;     // binary mask (read-only)
Texture2D<float>    _GrayIn;       // grayscale (read-only)
RWTexture2D<float2> _SeedBufOut;   // seed buffer write (sub-pixel coords, or NO_SEED)
Texture2D<float2>   _SeedBufIn;    // seed buffer read

// --- Distance ---
RWTexture2D<float>  _DistanceOut;  // raw distance to nearest boundary (pixels, unclamped)
Texture2D<float>    _DistanceIn;   // distance map (read-only)

// --- Blur / profile ---
RWTexture2D<float>  _BlurTmpOut;   // horizontal blur scratch
Texture2D<float>    _BlurTmpIn;
RWTexture2D<float>  _IntensityOut; // profile intensity (0.0 - 1.0)

// --- Composite ---
Texture2D<float>    _IntensityIn;  // profile intensity (read-only)
RWTexture2D<float>  _HeightMapOut; // height map output

// --- Normal map ---
Texture2D<float>    _HeightMapIn;  // height map (read-only)
RWTexture2D<float4> _NormalMapOut; // RGBA normal map output

// ================================================================
// Helper: linear -> sRGB (display space)
//
// In a Linear-color-space project an sRGB-imported texture is decoded to
// linear by the sampler. The threshold slider and the GrayWeight ramp are
// authored against what the user sees in an image editor, so we undo that
// decode and work in display space.
// ================================================================
float3 LinearToDisplay(float3 c)
{
    c = max(c, 0.0);
    return (c <= 0.0031308) ? (c * 12.92)
                            : (1.055 * pow(c, 1.0 / 2.4) - 0.055);
}

// ================================================================
// Helper: apply profile curve to a normalized distance (0-1)
// ================================================================
float ProfileCurve(float nd)
{
    nd = saturate(nd);
    if (_ProfileType == 0)       // Linear
        return nd;
    else if (_ProfileType == 1)  // Logarithmic
        return log(1.0 + 9.0 * nd) / log(10.0);
    else if (_ProfileType == 2)  // Exponential
        return (exp(nd * 2.5) - 1.0) / (exp(2.5) - 1.0);
    else                         // Smoothstep (slope-continuous at both ends)
        return nd * nd * (3.0 - 2.0 * nd);
}

// ================================================================
// Helper: clamped reads
// ================================================================
float SampleH(int x, int y)
{
    x = clamp(x, 0, _Width  - 1);
    y = clamp(y, 0, _Height - 1);
    return _HeightMapIn[uint2(x, y)];
}

float SampleGray(int x, int y)
{
    x = clamp(x, 0, _Width  - 1);
    y = clamp(y, 0, _Height - 1);
    return _GrayIn[uint2(x, y)];
}

// ================================================================
// Helper: cheap per-pixel hash, used for dithering
// ================================================================
float Hash12(float2 p, float salt)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031 + salt);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

// ================================================================
// Kernel: Binarize
//   Box-downsamples the source into the working resolution, converts to
//   display-space grayscale (ITU-R BT.601) and thresholds it.
//   When source and working resolution match this degenerates to a single
//   tap, so preview and final output run identical math.
//   InvertMask flips the gray value before thresholding.
// ================================================================
[numthreads(8, 8, 1)]
void Binarize(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Width || (int)id.y >= _Height) return;

    float ratioX = (float)_SrcWidth  / (float)_Width;
    float ratioY = (float)_SrcHeight / (float)_Height;

    int x0 = (int)floor(id.x * ratioX);
    int y0 = (int)floor(id.y * ratioY);
    int x1 = min(_SrcWidth,  max(x0 + 1, (int)floor((id.x + 1) * ratioX)));
    int y1 = min(_SrcHeight, max(y0 + 1, (int)floor((id.y + 1) * ratioY)));

    // Cap the tap count so an extreme downscale ratio cannot stall the shader.
    // Spans are >= 1 here, so the shift is an exact ceil-divide by MAX_BOX_TAPS.
    int stepX = max(1, ((x1 - x0) + MAX_BOX_TAPS - 1) >> MAX_BOX_TAPS_LOG2);
    int stepY = max(1, ((y1 - y0) + MAX_BOX_TAPS - 1) >> MAX_BOX_TAPS_LOG2);

    float3 acc = float3(0.0, 0.0, 0.0);
    float  n   = 0.0;

    [loop] for (int sy = y0; sy < y1; sy += stepY)
    {
        [loop] for (int sx = x0; sx < x1; sx += stepX)
        {
            acc += _InputTex[uint2(sx, sy)].rgb;
            n   += 1.0;
        }
    }

    // Averaging happens in whatever space the sampler handed us (linear for an
    // sRGB asset), which is the correct space to resample in.
    float3 rgb = acc / max(n, 1.0);
    if (_InputIsLinear)
        rgb = LinearToDisplay(rgb);

    float gray = dot(rgb, float3(0.299, 0.587, 0.114));
    if (_InvertMask)
        gray = 1.0 - gray;
    gray = saturate(gray);

    _GrayOut[id.xy]   = gray;
    _BinaryOut[id.xy] = (gray > _Threshold) ? 1.0 : 0.0;
}

// ================================================================
// Kernel: JFA_Init
//   Marks boundary pixels (binary=1 with at least one binary=0 neighbour)
//   as seeds.
//
//   Rather than seeding the pixel centre, the crossing point of the gray
//   field with the threshold is estimated to sub-pixel accuracy. Solving
//   gray(p + t) = threshold to first order gives t = -grad * gc / |grad|^2.
//   The derivative is taken one-sided towards the darker neighbour: a
//   central difference halves the slope across a hard step edge and would
//   overshoot the boundary by half a pixel.
//
//   This removes both the staircase quantization of the distance field and
//   the systematic half-pixel outward bias of centre-only seeding.
// ================================================================
[numthreads(8, 8, 1)]
void JFA_Init(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Width || (int)id.y >= _Height) return;

    float2 seed = float2(NO_SEED, NO_SEED);

    if (_BinaryIn[id.xy] >= 0.5)
    {
        bool   isBoundary = false;
        float2 bgDir      = float2(0.0, 0.0);

        for (int dy = -1; dy <= 1; dy++)
        {
            for (int dx = -1; dx <= 1; dx++)
            {
                if (dx == 0 && dy == 0) continue;
                int nx = (int)id.x + dx;
                int ny = (int)id.y + dy;
                // Out-of-bounds neighbours are ignored so that the image
                // border does not read as an edge and grow a bevel.
                if (nx < 0 || nx >= _Width || ny < 0 || ny >= _Height)
                    continue;
                if (_BinaryIn[uint2(nx, ny)] < 0.5)
                {
                    isBoundary = true;
                    // Unit vector towards this background neighbour; the sum
                    // points at the background side of the edge.
                    bgDir += float2((float)dx, (float)dy)
                             * rsqrt((float)(dx * dx + dy * dy));
                }
            }
        }

        if (isBoundary)
        {
            int x = (int)id.x;
            int y = (int)id.y;

            float gc  = SampleGray(x, y);
            float gxp = SampleGray(x + 1, y);
            float gxm = SampleGray(x - 1, y);
            float gyp = SampleGray(x, y + 1);
            float gym = SampleGray(x, y - 1);

            float ddx = (gxp < gxm) ? (gxp - gc) : (gc - gxm);
            float ddy = (gyp < gym) ? (gyp - gc) : (gc - gym);

            float2 grad = float2(ddx, ddy);
            float  g2   = dot(grad, grad);

            float2 offset = float2(0.0, 0.0);
            if (g2 > 1e-8)
            {
                offset = -grad * ((gc - _Threshold) / g2);
                float len = length(offset);
                // A first-order estimate is only trustworthy near the pixel;
                // clamp so a nearly-flat neighbourhood cannot fling the seed.
                if (len > 1.5)
                    offset *= 1.5 / len;
            }
            else
            {
                // Degenerate gradient: the 4-neighbourhood is flat even though a
                // diagonal neighbour is background. Happens on hard-edged masks
                // and wherever an anti-aliased ramp has already saturated.
                // Fall back to half a pixel towards the background side, which
                // measures roughly twice as accurate as seeding the centre.
                float dl = length(bgDir);
                if (dl > 1e-6)
                    offset = bgDir * (0.5 / dl);
            }

            seed = float2((float)x, (float)y) + offset;
        }
    }

    _SeedBufOut[id.xy] = seed;
}

// ================================================================
// Kernel: JFA_Step
//   One pass of Jump Flooding. Each pixel looks at 8 neighbours
//   at offset +/-_JFAStep and keeps the closest seed.
// ================================================================
[numthreads(8, 8, 1)]
void JFA_Step(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Width || (int)id.y >= _Height) return;

    float2 pos  = float2((float)id.x, (float)id.y);
    float2 best = _SeedBufIn[id.xy];
    float  bestDist = IS_SEED(best) ? distance(pos, best) : 1e20;

    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            if (dx == 0 && dy == 0) continue;
            int nx = (int)id.x + dx * _JFAStep;
            int ny = (int)id.y + dy * _JFAStep;
            if (nx < 0 || nx >= _Width || ny < 0 || ny >= _Height) continue;

            float2 s = _SeedBufIn[uint2(nx, ny)];
            if (!IS_SEED(s)) continue;

            float d = distance(pos, s);
            if (d < bestDist)
            {
                bestDist = d;
                best = s;
            }
        }
    }

    _SeedBufOut[id.xy] = best;
}

// ================================================================
// Kernel: JFA_Distance
//   Computes raw L2 distance (pixels) from each pixel to its nearest seed.
//   Background pixels are zeroed. Interior pixels that never received a seed
//   get DIST_FAR. Nothing here depends on _BevelRadius, which is what lets
//   the host cache this result across radius changes.
// ================================================================
[numthreads(8, 8, 1)]
void JFA_Distance(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Width || (int)id.y >= _Height) return;

    // Background pixels have no bevel
    if (_BinaryIn[id.xy] < 0.5)
    {
        _DistanceOut[id.xy] = 0.0;
        return;
    }

    float2 seed = _SeedBufIn[id.xy];
    if (!IS_SEED(seed))
    {
        _DistanceOut[id.xy] = DIST_FAR;
        return;
    }

    _DistanceOut[id.xy] = distance(float2((float)id.x, (float)id.y), seed);
}

// ================================================================
// Kernel: BlurProfileH
//   Normalizes the distance field against the bevel radius and runs the
//   horizontal half of a separable gaussian. Normalizing before the blur
//   keeps DIST_FAR from smearing across the image.
// ================================================================
[numthreads(8, 8, 1)]
void BlurProfileH(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Width || (int)id.y >= _Height) return;

    float invR    = 1.0 / max(_BevelRadius, 1e-4);
    float inv2s2  = 1.0 / (2.0 * _BlurSigma * _BlurSigma);
    float sum     = 0.0;
    float weight  = 0.0;

    [loop] for (int t = -_BlurRadius; t <= _BlurRadius; t++)
    {
        int nx = clamp((int)id.x + t, 0, _Width - 1);
        float nd = saturate(_DistanceIn[uint2(nx, (int)id.y)] * invR);
        float w  = exp(-(float)(t * t) * inv2s2);
        sum    += nd * w;
        weight += w;
    }

    _BlurTmpOut[id.xy] = sum / weight;
}

// ================================================================
// Kernel: BlurProfileV
//   Vertical half of the gaussian, then the profile curve. Evaluating the
//   curve once after the blur (instead of per tap) keeps the log/exp cost
//   at one evaluation per pixel.
// ================================================================
[numthreads(8, 8, 1)]
void BlurProfileV(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Width || (int)id.y >= _Height) return;

    float inv2s2 = 1.0 / (2.0 * _BlurSigma * _BlurSigma);
    float sum    = 0.0;
    float weight = 0.0;

    [loop] for (int t = -_BlurRadius; t <= _BlurRadius; t++)
    {
        int ny = clamp((int)id.y + t, 0, _Height - 1);
        float w = exp(-(float)(t * t) * inv2s2);
        sum    += _BlurTmpIn[uint2((int)id.x, ny)] * w;
        weight += w;
    }

    _IntensityOut[id.xy] = ProfileCurve(sum / weight);
}

// ================================================================
// Kernel: CompositeHeightMap
//   Combines the bevel intensity with the base mask.
//   Threshold mode: base = binary
//   GrayWeight mode: base = gray
//   Height = min(base, intensity)  (or just base when bevel disabled)
// ================================================================
[numthreads(8, 8, 1)]
void CompositeHeightMap(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Width || (int)id.y >= _Height) return;

    float base = (_InputMode == 0)
        ? _BinaryIn[id.xy]
        : _GrayIn[id.xy];

    float height;
    if (_DisableBevel)
        height = base;
    else
        height = min(base, _IntensityIn[id.xy]);

    _HeightMapOut[id.xy] = height;
}

// ================================================================
// Kernel: GenerateNormalMap
//   3x3 Sobel filter with BORDER_REPLICATE on height map.
//   Packs (X, Y, Z) into RGB with strength / 8.0 scaling.
//   A triangular-PDF dither of +/-1 LSB is applied before the implicit
//   8-bit quantization, which removes the terracing that shallow bevel
//   slopes otherwise show.
// ================================================================
[numthreads(8, 8, 1)]
void GenerateNormalMap(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Width || (int)id.y >= _Height) return;

    int x = (int)id.x;
    int y = (int)id.y;

    // Sobel X kernel: [-1, 0, +1; -2, 0, +2; -1, 0, +1]
    float sx =
        -SampleH(x-1, y-1) + SampleH(x+1, y-1)
        - 2.0 * SampleH(x-1, y) + 2.0 * SampleH(x+1, y)
        - SampleH(x-1, y+1) + SampleH(x+1, y+1);

    // Sobel Y kernel: [-1, -2, -1; 0, 0, 0; +1, +2, +1]
    float sy =
        -SampleH(x-1, y-1) - 2.0 * SampleH(x, y-1) - SampleH(x+1, y-1)
        + SampleH(x-1, y+1) + 2.0 * SampleH(x, y+1) + SampleH(x+1, y+1);

    // Scale with strength (theoretical max of 3x3 Sobel = 8.0 for float input)
    sx = sx * _Strength / 8.0;
    sy = sy * _Strength / 8.0;
    float sz = sqrt(max(0.0, 1.0 - sx * sx - sy * sy));

    // Pack into [0, 1] range: R=X, G=Y, B=Z, A=1
    float r = 0.5 - sx * 0.5;  // X
    float b = 0.5 + sz * 0.5;  // Z

    float g;
    if (_NormalMapType == 0)   // DirectX (Y+)
        g = 0.5 - sy * 0.5;
    else                       // OpenGL (Y-)
        g = 0.5 + sy * 0.5;

    if (_DitherEnabled)
    {
        float2 p = float2((float)x, (float)y);
        float lsb = 1.0 / 255.0;
        r += (Hash12(p, 0.11) - Hash12(p, 0.37)) * lsb;
        g += (Hash12(p, 0.53) - Hash12(p, 0.79)) * lsb;
        b += (Hash12(p, 0.91) - Hash12(p, 0.23)) * lsb;
    }

    _NormalMapOut[id.xy] = float4(saturate(r), saturate(g), saturate(b), 1.0);
}
